  edge [color="#36758d", fontcolor="#36576b", fontname="DejaVu Sans", fontsize=11, penwidth=1.4, arrowsize=0.7];
  resident [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/em/execution/LeptonCascade.inl#L82" TARGET="_blank"><FONT COLOR="#136d88"><B>LeptonCascade.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Completed resident e− / e+ steps</TD></TR><TR><TD ALIGN="LEFT">accumulateLeptonTracks(...)</TD></TR></TABLE>>];
  host [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/application/cascade/CascadeRunner.inl#L123" TARGET="_blank"><FONT COLOR="#136d88"><B>CascadeRunner.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Captured native e− / e+ tracks</TD></TR><TR><TD ALIGN="LEFT">HostRadioCollector; prefix spool replay</TD></TR></TABLE>>];
  accumulator [fillcolor="#e3f3eb", color="#65a78a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/radio/RadioAccumulator.inl#L293" TARGET="_blank"><FONT COLOR="#136d88"><B>RadioAccumulator.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Resident records or staged host batches</TD></TR><TR><TD ALIGN="LEFT">Track kinematics and observer-pair work</TD></TR></TABLE>>];
  config [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/application/cascade/CascadePreparation.inl#L91" TARGET="_blank"><FONT COLOR="#136d88"><B>CascadePreparation.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">RadioConfig</TD></TR><TR><TD ALIGN="LEFT">Observer snapshots + propagation data</TD></TR></TABLE>>];
  projection [fillcolor="#e3f3eb", color="#65a78a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/radio/algorithms/RadioProjection.inl#L339" TARGET="_blank"><FONT COLOR="#136d88"><B>RadioProjection.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">CoREAS endpoint / ZHS track projection</TD></TR><TR><TD ALIGN="LEFT">Accumulate observer waveform bins</TD></TR></TABLE>>];
  download [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/EmRouter.inl#L219" TARGET="_blank"><FONT COLOR="#136d88"><B>EmRouter.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">downloadRadioWaveforms()</TD></TR><TR><TD ALIGN="LEFT">CoREAS electric field; ZHS vector potential</TD></TR></TABLE>>];
  bridge [fillcolor="#eee8f7", color="#9e81be", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/output/CorsikaOutputSink.inl#L254" TARGET="_blank"><FONT COLOR="#136d88"><B>CorsikaOutputSink.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">onGpuRadioWaveforms(...)</TD></TR><TR><TD ALIGN="LEFT">Add components to matching native observers</TD></TR></TABLE>>];
  output [fillcolor="#eee8f7", color="#9e81be", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/modules/radio/RadioProcess.inl#L182" TARGET="_blank"><FONT COLOR="#136d88"><B>RadioProcess.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">endOfShower(...)</TD></TR><TR><TD ALIGN="LEFT">Write CoREAS fields; differentiate ZHS potential</TD></TR></TABLE>>];
  {rank=same; resident; host;}
  {rank=same; accumulator; config;}
  resident -> accumulator [label="resident step views"];
  host -> accumulator [label="copied host records"];
  config -> accumulator [label="initialize", constraint=false];
  accumulator -> projection [label="direct or tiled launch"];
  projection -> download [label="flush pending work; transfer accumulated arrays"];
  download -> bridge [label="observer-ordered x / y / z arrays"];
  bridge -> output [color="#8863a6", fontcolor="#76518e", label="native waveform storage"];
}
