digraph TransportStep {
  graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.5", ranksep="0.55", splines=polyline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", color="#a6c6d2", fillcolor="#f1f7fa", fontname="DejaVu Sans", fontsize=13, margin="0.14,0.10", penwidth=1.2];
  edge [color="#36758d", fontcolor="#36576b", fontname="DejaVu Sans", fontsize=11, penwidth=1.4, arrowsize=0.7];
  front [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/em/execution/LeptonFront.inl#L275" TARGET="_blank"><FONT COLOR="#136d88"><B>LeptonFront.inl / PhotonFront.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Current particle state + shared physics context</TD></TR><TR><TD ALIGN="LEFT">Launch per-source kernels in stage order</TD></TR></TABLE>>];
  selection [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/em/algorithms/InteractionSelection.inl#L12" TARGET="_blank"><FONT COLOR="#136d88"><B>InteractionSelection.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">select_discrete_interaction(...)</TD></TR><TR><TD ALIGN="LEFT">Return candidate depth and stage record</TD></TR></TABLE>>];
  lepton [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/em/algorithms/LeptonTransportStep.inl#L28" TARGET="_blank"><FONT COLOR="#136d88"><B>LeptonTransportStep.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">transport_lepton(...)</TD></TR><TR><TD ALIGN="LEFT">Compete limits; magnetic advance; continuous loss</TD></TR></TABLE>>];
  moliere [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/em/algorithms/MoliereStep.inl#L74" TARGET="_blank"><FONT COLOR="#136d88"><B>MoliereStep.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">apply_moliere_scattering_stage(...)</TD></TR><TR><TD ALIGN="LEFT">Complete the charged-lepton direction update</TD></TR></TABLE>>];
  vertex [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/em/algorithms/LeptonVertexSelection.inl#L41" TARGET="_blank"><FONT COLOR="#136d88"><B>LeptonVertexSelection.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">select_lepton_vertex(...)</TD></TR><TR><TD ALIGN="LEFT">Accept vertex; select channel at post-loss energy</TD></TR></TABLE>>];
  leptonfinal [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/em/algorithms/LeptonFinalStateStep.inl#L683" TARGET="_blank"><FONT COLOR="#136d88"><B>LeptonFinalStateStep.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">classify_lepton_final_state(...)</TD></TR><TR><TD ALIGN="LEFT">Prepare retained products or continuation</TD></TR></TABLE>>];
  photon [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/em/algorithms/PhotonTransportStep.inl#L58" TARGET="_blank"><FONT COLOR="#136d88"><B>PhotonTransportStep.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">transport_photon(...)</TD></TR><TR><TD ALIGN="LEFT">Compete straight flight with boundaries and observation</TD></TR></TABLE>>];
  photonfinal [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/em/algorithms/PhotonFinalStateStep.inl#L273" TARGET="_blank"><FONT COLOR="#136d88"><B>PhotonFinalStateStep.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">classify_photon_final_state(...)</TD></TR><TR><TD ALIGN="LEFT">Prepare retained products or continuation</TD></TR></TABLE>>];
  materialize [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/kokkos/em/algorithms/PhotonFinalStateStep.hpp#L99" TARGET="_blank"><FONT COLOR="#136d88"><B>Final-state materialization</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Front scans assign exclusive output slots</TD></TR><TR><TD ALIGN="LEFT">Writers produce particle states and records</TD></TR></TABLE>>, fillcolor="#e3f3eb", color="#65a78a"];
  consume [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/EmRouter.inl#L547" TARGET="_blank"><FONT COLOR="#136d88"><B>Resident queues and host consumers</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Queue retained particles; consume reaction records</TD></TR><TR><TD ALIGN="LEFT">Route specified CPU completion requests</TD></TR></TABLE>>, fillcolor="#e3f3eb", color="#65a78a"];
  front -> selection;
  selection -> lepton [label="charged lepton: depth only"];
  selection -> photon [label="photon: channel prepared"];
  {rank=same; lepton; photon;}
  lepton -> moliere;
  moliere -> vertex [label="reached candidate vertex"];
  vertex -> leptonfinal [label="accepted vertex"];
  photon -> photonfinal [label="reached interaction vertex", minlen=3];
  {rank=same; leptonfinal; photonfinal;}
  leptonfinal -> materialize;
  photonfinal -> materialize;
  materialize -> consume [label="capacity-checked results and preserved identities"];
}
