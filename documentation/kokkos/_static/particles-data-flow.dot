digraph ParticleFlow {
  graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.45", ranksep="0.5", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", color="#a6c6d2", fillcolor="#f1f7fa", fontname="DejaVu Sans", fontsize=13, margin="0.14,0.10", penwidth=1.2];
  edge [color="#36758d", fontcolor="#36576b", fontname="DejaVu Sans", fontsize=11, penwidth=1.4, arrowsize=0.7];
  native [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/stack/VectorStack.hpp#L30" TARGET="_blank"><FONT COLOR="#136d88"><B>VectorStack.hpp</B></FONT></TD></TR><TR><TD ALIGN="LEFT">C8 stack particle</TD></TR><TR><TD ALIGN="LEFT">Typed values + weight + logical node</TD></TR><TR><TD ALIGN="LEFT">HybridStack: stable transport identity</TD></TR></TABLE>>];
  export [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/data/RouterParticleConversion.inl#L51" TARGET="_blank"><FONT COLOR="#136d88"><B>RouterParticleConversion.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">to_device_state(...) → ParticleState</TD></TR><TR><TD ALIGN="LEFT">Transform coordinates; convert units</TD></TR><TR><TD ALIGN="LEFT">Copy identity; map the logical node</TD></TR></TABLE>>];
  stage [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/EmRouter.inl#L115" TARGET="_blank"><FONT COLOR="#136d88"><B>EmRouter.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">EmRouter::stage(...)</TD></TR><TR><TD ALIGN="LEFT">Set mediumId_; append to staged_</TD></TR><TR><TD ALIGN="LEFT">Dispatch photon / charged-lepton records</TD></TR></TABLE>>];
  upload [fillcolor="#e3f3eb", color="#65a78a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/WavefrontQueue.inl#L208" TARGET="_blank"><FONT COLOR="#136d88"><B>WavefrontQueue.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">WavefrontQueue::upload(...)</TD></TR><TR><TD ALIGN="LEFT">Retained AoS staging → ParticleSoA</TD></TR><TR><TD ALIGN="LEFT">Resident prefix + host suffix</TD></TR></TABLE>>];
  arrays [fillcolor="#e3f3eb", color="#65a78a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/data/ParticleSoA.inl#L13" TARGET="_blank"><FONT COLOR="#136d88"><B>ParticleSoA.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ParticleSoARawView::load / store</TD></TR><TR><TD ALIGN="LEFT">Current fields → local state → next fields</TD></TR><TR><TD ALIGN="LEFT">Transport uses shared physics and environment data</TD></TR></TABLE>>];
  next [fillcolor="#e3f3eb", color="#65a78a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/WavefrontQueue.inl#L165" TARGET="_blank"><FONT COLOR="#136d88"><B>WavefrontQueue.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">WavefrontQueue::commitNext...(...)</TD></TR><TR><TD ALIGN="LEFT">Swap current and next allocations</TD></TR><TR><TD ALIGN="LEFT">Preserve particle identities</TD></TR></TABLE>>];
  return [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/EmRouter.inl#L709" TARGET="_blank"><FONT COLOR="#136d88"><B>EmRouter.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">EmRouter return paths</TD></TR><TR><TD ALIGN="LEFT">Handle CPU requests and cut policies</TD></TR><TR><TD ALIGN="LEFT">Import valid states requiring native processing</TD></TR></TABLE>>];
  import [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/data/RouterParticleConversion.inl#L79" TARGET="_blank"><FONT COLOR="#136d88"><B>RouterParticleConversion.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">import_particle(...) → native handle</TD></TR><TR><TD ALIGN="LEFT">Total → kinetic energy; restore typed values</TD></TR><TR><TD ALIGN="LEFT">Restore identity, weight and native node</TD></TR></TABLE>>];
  native -> export [label="particle + common frame + identity + topology"];
  export -> stage [label="complete numerical record"];
  stage -> upload [label="bounded input vector"];
  upload -> arrays [label="execution-space field arrays"];
  arrays -> next [label="retained states"];
  next -> arrays [label="next front", style=dashed, constraint=false];
  arrays -> return [label="states returned for CPU processing", style=dashed];
  next -> return [style=invis];
  return -> import [label="valid state + matching topology"];
  import -> native [label="new native stack entry", style=dashed, constraint=false];
}
