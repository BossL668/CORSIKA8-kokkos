+#include <map>
+#include <corsika/modules/FLUKA.hpp>
+// Mountain-only FLUKA target setup, adapted from the CORSIKA BSD-3-Clause wrapper.
+// Original air FLUKA headers and the external FLUKA library are unchanged.
