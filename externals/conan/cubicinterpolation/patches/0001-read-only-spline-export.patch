+template <typename T>
+typename CubicSplines<T>::ExportData CubicSplines<T>::Export() const {
+  auto node_derivatives = std::vector<T>(data->y.size());
+  for (std::size_t node = 0; node < node_derivatives.size(); ++node)
+    node_derivatives[node] = data->spline.prime(static_cast<T>(node));
+  return {data->y, std::move(node_derivatives), data->lower_lim_derivate,
+          data->upper_lim_derivate};
+}
