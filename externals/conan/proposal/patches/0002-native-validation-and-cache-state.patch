+        auto const* source = dynamic_cast<CrossSectionDNDXInterpolant const*>(
+            std::get<1>(entry->second).get());
+        if (!source)
+            throw std::logic_error(
+                "dN/dX calculator does not use the native interpolant");
+        return source->EvaluateInterpolation(energy, transformed_loss)
+            / std::get<0>(entry->second);
+    }
 };

