+    cubic_splines::BicubicSplines<double>::ExportData spline;
+};
+
+struct DedxInterpolationExport {
+    InteractionType interaction_type{InteractionType::Undefined};
+    std::string parametrization;
+    std::size_t cross_section_hash{};
+    std::size_t table_hash{};
+    std::size_t component_index{};
+    double component_weight{1.};
+    double lower_energy_limit_MeV{};
+    cubic_splines::AxisDescriptor<double> axis;
+    bool has_value_transform{};
+    cubic_splines::AxisDescriptor<double> value_transform;
+    cubic_splines::CubicSplines<double>::ExportData spline;
+};
+
+struct UtilityInterpolationExport {
+    bool available{};
+    bool reverse{};
+    std::size_t table_hash{};
+    double lower_energy_limit_MeV{};
+    cubic_splines::AxisDescriptor<double> axis;
+    bool has_value_transform{};
+    cubic_splines::AxisDescriptor<double> value_transform;
+    cubic_splines::CubicSplines<double>::ExportData spline;
+};
+
+struct LpmInterpolationExport {
+    double particle_mass_MeV{};
+    double molecular_density_per_cm3{};
+    double mass_density_g_per_cm3{};
+    double sum_charge{};
+    double e_lpm_MeV{};
+};
+
+} // namespace PROPOSAL
