+namespace PROPOSAL {
+
+enum class RelativeLossTransform : unsigned int {
+    RelativeLog = 0,
+    RelativeLogPowerOnePointFive = 1,
+    OneMinusLog = 2,
+};
+
+struct DndxInterpolationExport {
+    InteractionType interaction_type{InteractionType::Undefined};
+    RelativeLossTransform loss_transform{RelativeLossTransform::RelativeLog};
+    std::string parametrization;
+    std::size_t cross_section_hash{};
+    std::size_t table_hash{};
+    std::size_t component_hash{};
+    double component_weight{1.};
+    double lower_energy_limit_MeV{};
