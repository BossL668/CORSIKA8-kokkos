+TotalRateInterpolationExport
+InteractionBuilder::ExportTotalRateInterpolation() const
+{
+    TotalRateInterpolationExport result;
+    result.available = rate_interpolant_ != nullptr;
+    result.table_hash = rate_interpolant_hash_;
+    result.cache_hit = rate_table_available_before_build_;
+    result.lower_energy_limit_MeV = rate_lower_energy_lim;
+    if (!rate_interpolant_)
+        return result;
+    auto const& definition = rate_interpolant_->GetDefinition();
+    result.axis = definition.GetAxis().ExportDescriptor();
+    result.has_value_transform = definition.f_trafo != nullptr;
+    if (definition.f_trafo)
+        result.value_transform = definition.f_trafo->ExportDescriptor();
+    result.spline = rate_interpolant_->ExportData();
+    return result;
+}
