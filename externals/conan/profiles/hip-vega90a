include(default)

# MI200-series / ROCm 6.x example. hipcc must compile all Kokkos-enabled C++
# translation units; update the Conan clang version when the target ROCm
# release reports another bundled LLVM major.
[settings]
compiler=clang
compiler.version=18
compiler.libcxx=libstdc++11
compiler.cppstd=17

[conf]
# Keep ordinary dependencies on the host compiler. Kokkos enables HIP in CMake.
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
&:tools.build:compiler_executables={"c": "clang", "cpp": "hipcc"}

[options]
&:with_kokkos=True
&:kokkos_backend=hip
&:kokkos_architecture=VEGA90A
