include(default)

# Hygon Z100 / DTK 22.10.1 (HIP 5.2, Clang 14). Source the vendor env.sh first.
[settings]
compiler=clang
compiler.version=14
compiler.libcxx=libstdc++11
compiler.cppstd=17

[conf]
# Ordinary dependencies use the host compiler. Only the application needs
# hipcc for device-enabled C++ headers; Kokkos enables CMake's HIP language.
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
&:tools.build:compiler_executables={"c": "clang", "cpp": "hipcc"}

[options]
&:with_kokkos=True
&:kokkos_backend=hip
&:kokkos_architecture=VEGA906
