include(default)

# Z100 / gfx906 with DTK 26.04 (Clang 17). Source the vendor env.sh first.
# This profile selects the toolchain; it does not certify a working GPU driver.
[settings]
compiler=clang
compiler.version=17
compiler.libcxx=libstdc++11
compiler.cppstd=17

[conf]
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
&:tools.build:compiler_executables={"c": "clang", "cpp": "hipcc"}

[options]
&:with_kokkos=True
&:kokkos_backend=hip
&:kokkos_architecture=VEGA906
