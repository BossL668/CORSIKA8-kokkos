# Build-interface adaptation only: do not alter generic Runtime or Kokkos itself.
set (CORSIKA_KOKKOS_BACKEND "AUTO" CACHE STRING
  "Production runtime backend (AUTO preserves unsupported generic configurations)")
set_property (CACHE CORSIKA_KOKKOS_BACKEND PROPERTY STRINGS
  AUTO NONE OPENMP CUDA HIP SYCL CUDA_OPENMP)
string (TOUPPER "${CORSIKA_KOKKOS_BACKEND}" CORSIKA_KOKKOS_REQUESTED_BACKEND)
if (NOT CORSIKA_KOKKOS_REQUESTED_BACKEND MATCHES
    "^(AUTO|NONE|OPENMP|CUDA|HIP|SYCL|CUDA_OPENMP)$")
  message (FATAL_ERROR "Unknown production runtime backend: ${CORSIKA_KOKKOS_BACKEND}")
endif ()
set (CORSIKA_KOKKOS_DEVICE_SET "")
foreach (DEVICE IN LISTS Kokkos_DEVICES)
  string (TOUPPER "${DEVICE}" DEVICE_UPPER)
  list (APPEND CORSIKA_KOKKOS_DEVICE_SET "${DEVICE_UPPER}")
endforeach ()
list (REMOVE_DUPLICATES CORSIKA_KOKKOS_DEVICE_SET)
list (SORT CORSIKA_KOKKOS_DEVICE_SET)
set (CORSIKA_KOKKOS_DETECTED_BACKEND "NONE")
if (CORSIKA_KOKKOS_DEVICE_SET STREQUAL "OPENMP" OR
    CORSIKA_KOKKOS_DEVICE_SET STREQUAL "OPENMP;SERIAL")
  set (CORSIKA_KOKKOS_DETECTED_BACKEND "OPENMP")
elseif (CORSIKA_KOKKOS_DEVICE_SET STREQUAL "CUDA;SERIAL")
  set (CORSIKA_KOKKOS_DETECTED_BACKEND "CUDA")
elseif (CORSIKA_KOKKOS_DEVICE_SET STREQUAL "HIP;SERIAL")
  set (CORSIKA_KOKKOS_DETECTED_BACKEND "HIP")
elseif (CORSIKA_KOKKOS_DEVICE_SET STREQUAL "SERIAL;SYCL")
  set (CORSIKA_KOKKOS_DETECTED_BACKEND "SYCL")
elseif (CORSIKA_KOKKOS_DEVICE_SET STREQUAL "CUDA;OPENMP" OR
        CORSIKA_KOKKOS_DEVICE_SET STREQUAL "CUDA;OPENMP;SERIAL")
  set (CORSIKA_KOKKOS_DETECTED_BACKEND "CUDA_OPENMP")
endif ()
if (CORSIKA_KOKKOS_REQUESTED_BACKEND STREQUAL "AUTO")
  set (CORSIKA_KOKKOS_RESOLVED_BACKEND "${CORSIKA_KOKKOS_DETECTED_BACKEND}")
elseif (CORSIKA_KOKKOS_REQUESTED_BACKEND STREQUAL "NONE")
  set (CORSIKA_KOKKOS_RESOLVED_BACKEND "NONE")
elseif (NOT CORSIKA_KOKKOS_REQUESTED_BACKEND STREQUAL CORSIKA_KOKKOS_DETECTED_BACKEND)
  message (FATAL_ERROR
    "Requested production backend ${CORSIKA_KOKKOS_REQUESTED_BACKEND} does not match "
    "Kokkos devices '${CORSIKA_KOKKOS_DEVICE_SET}' (supported combination: "
    "${CORSIKA_KOKKOS_DETECTED_BACKEND}). Generic Runtime remains available with AUTO/NONE.")
else ()
  set (CORSIKA_KOKKOS_RESOLVED_BACKEND "${CORSIKA_KOKKOS_REQUESTED_BACKEND}")
endif ()
if (CORSIKA_KOKKOS_RESOLVED_BACKEND STREQUAL "NONE")
  message (STATUS
    "Production BackendRuntime is omitted for '${CORSIKA_KOKKOS_DEVICE_SET}'; generic Runtime is unchanged.")
endif ()
