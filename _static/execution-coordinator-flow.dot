  coord [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/src/kokkos/scheduling/AirShowerCoordinator.cpp#L649" TARGET="_blank"><FONT COLOR="#136d88"><B>AirShowerCoordinator.cpp</B></FONT></TD></TR><TR><TD ALIGN="LEFT">run(CoordinatorOptions) -&gt; event(...)</TD></TR><TR><TD ALIGN="LEFT">Executable, physics settings, devices, seeds and limits</TD></TR></TABLE>>];
  serial [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/application/cascade/CascadeDriver.inl#L60" TARGET="_blank"><FONT COLOR="#136d88"><B>CascadeDriver.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Serial CPU prefix</TD></TR><TR><TD ALIGN="LEFT">CaptureRouter writes the EM frontier.</TD></TR></TABLE>>];
  bootstrap [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/CpuFrontier.inl" TARGET="_blank"><FONT COLOR="#136d88"><B>CpuFrontier.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">CPU bootstrap -&gt; cpu_frontier.txt</TD></TR><TR><TD ALIGN="LEFT">Coordinator partition(...) -&gt; CPU-prefix workers</TD></TR></TABLE>>];
  cpus [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/application/cascade/CascadeDriver.inl#L60" TARGET="_blank"><FONT COLOR="#136d88"><B>CascadeDriver.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">CPU-prefix processes advance static roots.</TD></TR><TR><TD ALIGN="LEFT">Each CaptureRouter writes an EM frontier.</TD></TR></TABLE>>];
  join [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/src/kokkos/scheduling/AirShowerCoordinator.cpp#L478" TARGET="_blank"><FONT COLOR="#136d88"><B>AirShowerCoordinator.cpp</B></FONT></TD></TR><TR><TD ALIGN="LEFT">join_frontiers(...)</TD></TR><TR><TD ALIGN="LEFT">Combine completed, compatible EM frontier files.</TD></TR></TABLE>>];
  partition [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/src/kokkos/scheduling/AirShowerCoordinator.cpp#L485" TARGET="_blank"><FONT COLOR="#136d88"><B>AirShowerCoordinator.cpp</B></FONT></TD></TR><TR><TD ALIGN="LEFT">partition(frontier, shards)</TD></TR><TR><TD ALIGN="LEFT">partition_radio_tracks(spools, workers)</TD></TR><TR><TD ALIGN="LEFT">Record root counts and immutable-input hashes.</TD></TR></TABLE>>];
  worker [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/application/cascade/WorkerSession.inl#L107" TARGET="_blank"><FONT COLOR="#136d88"><B>WorkerSession.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">GPU workers: same application executable</TD></TR><TR><TD ALIGN="LEFT">WorkerSession::next(...) for a persistent worker</TD></TR><TR><TD ALIGN="LEFT">Set shard, radio inputs, event seed and output folder.</TD></TR></TABLE>>];
  feed [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/StaticFrontier.inl#L247" TARGET="_blank"><FONT COLOR="#136d88"><B>StaticFrontier.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">BufferedFrontierRouter -&gt; FrontierInput::refill(...)</TD></TR><TR><TD ALIGN="LEFT">Import a bounded block into the local C8 stack.</TD></TR><TR><TD ALIGN="LEFT">HybridCascade + EmRouter advance it on one GPU.</TD></TR></TABLE>>];
  merge [fillcolor="#e3f3eb", color="#65a78a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/src/kokkos/scheduling/AirShowerCoordinator.cpp#L587" TARGET="_blank"><FONT COLOR="#136d88"><B>AirShowerCoordinator.cpp</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Validate consumed roots, radio replay and output.</TD></TR><TR><TD ALIGN="LEFT">merge(prefix and worker outputs, destination)</TD></TR><TR><TD ALIGN="LEFT">Write TIMING.json and COMPLETE.json.</TD></TR></TABLE>>];
  main -> coord [label="CoordinatorOptions"];
  { rank=same; serial; bootstrap; }
  coord -> serial [label="prefixWorkers_ == 0"];
  coord -> bootstrap [label="prefixWorkers_ > 0"];
  bootstrap -> cpus [label="cpu_roots_<i>.txt"];
  cpus -> join [label="cpu_prefix_<i>_frontier.txt"];
  serial -> partition [label="frontier.txt"];
  join -> partition [label="frontier.txt"];
  partition -> worker [label="roots_<i>.txt + assigned radio spools"];
  worker -> feed [label="request bindings / cold-start arguments"];
  feed -> merge [label="closed worker outputs + prefix outputs"];
}
