  loop -> select [label="runnable CPU particle"];
  select -> route [label="particle + stepId"];
  { rank=same; scalar; staged; }
  route -> scalar [label="not routed / forced scalar action"];
  route -> staged [label="route accepted"];
  scalar -> select [style=dashed, label="stack survivors and children", constraint=false];
  staged -> advance [label="dispatch condition, or scalar stack empty"];
  advance -> select [style=dashed, label="small-batch CPU expansion", constraint=false];
  advance -> backend [label="particles + history range + limits"];
  backend -> results [label="PhotonCascadeResult / LeptonCascadeResult"];
  { rank=same; results; fallback; }
  results -> fallback [label="CPU requests", constraint=false];
  fallback -> select [style=dashed, label="imported states / completion products", constraint=false];
  results -> advance [style=dashed, label="remaining EM work", constraint=false];
  results -> output [label="returned records"];
  output -> finish [label="after all pending work is processed"];
