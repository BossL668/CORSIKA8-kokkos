  fallback [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/EmRouter.inl#L709" TARGET="_blank"><FONT COLOR="#136d88"><B>EmRouter.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">returnFallbacks() / flushDeferredFallbacks()</TD></TR><TR><TD ALIGN="LEFT">Selected-vertex completion or scalar return</TD></TR></TABLE>>];
  output [fillcolor="#e3f3eb", color="#65a78a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/kokkos/output/CorsikaOutputSink.hpp" TARGET="_blank"><FONT COLOR="#136d88"><B>CorsikaOutputSink.hpp</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Output accumulation</TD></TR><TR><TD ALIGN="LEFT">Replay returned records into C8 writers.</TD></TR><TR><TD ALIGN="LEFT">Accumulate their event-output contributions.</TD></TR></TABLE>>];
  finish [fillcolor="#e3f3eb", color="#65a78a", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD ALIGN="LEFT" HREF="https://github.com/BossL668/CORSIKA8-kokkos/blob/d5297c43c041a22b43c65c322d9b51bc7ec8e397/corsika/detail/kokkos/scheduling/HybridCascade.inl#L306" TARGET="_blank"><FONT COLOR="#136d88"><B>HybridCascade.inl</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Event finalization</TD></TR><TR><TD ALIGN="LEFT">EmRouter::endOfShower(): collect final accumulators</TD></TR><TR><TD ALIGN="LEFT">output_.endOfShower(); runner invokes onComplete.</TD></TR></TABLE>>];
  entry -> runner [label="event inputs and factories"];
